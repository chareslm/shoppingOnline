# Documentation copy of committed application.yml.
# Do not copy this file over backend/src/main/resources/application.yml.
# Runtime values come from environment variables / application-local.yml / Compose.
#
# [REQUIRED] JWT_SECRET, and a datasource (Compose or application-local.yml)
# [OPTIONAL] MAIL_*, CORS_ALLOWED_ORIGINS, MERCHANT_UPLOAD_DIR, health flags
spring:
  application:
    name: shopping-backend
  profiles:
    active: ${SPRING_PROFILES_ACTIVE:local}
  datasource:
    url: ${DB_URL:}
    username: ${DB_USERNAME:}
    password: ${DB_PASSWORD:}
  flyway:
    enabled: ${FLYWAY_ENABLED:true}
    baseline-on-migrate: ${FLYWAY_BASELINE_ON_MIGRATE:false}
    baseline-version: 2
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 50MB
  data:
    redis:
      host: ${REDIS_HOST:127.0.0.1}
      port: ${REDIS_PORT:6379}
  elasticsearch:
    uris: ${ELASTICSEARCH_URIS:http://127.0.0.1:9200}
  mail:
    host: ${MAIL_HOST:}
    port: ${MAIL_PORT:587}
    username: ${MAIL_USERNAME:}
    password: ${MAIL_PASSWORD:}
    properties:
      mail.smtp.auth: ${MAIL_SMTP_AUTH:true}
      mail.smtp.starttls.enable: ${MAIL_SMTP_STARTTLS_ENABLED:true}

server:
  port: ${SERVER_PORT:8080}

app:
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174}
  mail:
    from: ${MAIL_FROM:}
  merchant:
    # [OPTIONAL] Native fallback when MERCHANT_UPLOAD_DIR is unset.
    # Compose always overrides with /data/uploads.
    upload-dir: ${MERCHANT_UPLOAD_DIR:${user.home}/shopping-data/uploads}

trade:
  stock:
    mock-enabled: ${TRADE_STOCK_MOCK_ENABLED:false}
  payment:
    mock-enabled: ${TRADE_PAYMENT_MOCK_ENABLED:false}

mybatis-plus:
  mapper-locations: classpath*:mapper/**/*.xml
  configuration:
    map-underscore-to-camel-case: true

security:
  jwt:
    secret: ${JWT_SECRET:}
    access-token-ttl: PT30M
    refresh-token-ttl: P7D
  bootstrap-super-admin:
    enabled: ${BOOTSTRAP_SUPER_ADMIN_ENABLED:false}
    username: ${BOOTSTRAP_SUPER_ADMIN_USERNAME:}
    password: ${BOOTSTRAP_SUPER_ADMIN_PASSWORD:}

management:
  health:
    mail:
      enabled: ${MAIL_HEALTH_ENABLED:false}
  endpoints:
    web:
      exposure:
        include: health,info
