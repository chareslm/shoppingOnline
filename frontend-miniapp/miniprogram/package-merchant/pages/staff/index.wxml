<view class="page">
  <view class="card">
    <view class="title">客服账号</view>
    <view class="subtitle">{{shopName || '本店客服'}} · 新建后需平台审核才能登录</view>
    <view class="field">
      <text class="label">显示名</text>
      <input class="input" value="{{displayName}}" bindinput="onDisplayNameInput" />
    </view>
    <view class="field">
      <text class="label">邮箱</text>
      <input class="input" value="{{email}}" bindinput="onEmailInput" />
    </view>
    <view class="field">
      <text class="label">用户名（选填）</text>
      <input class="input" value="{{username}}" bindinput="onUsernameInput" />
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="primary" loading="{{submitting}}" bindtap="createStaff">创建客服</button>
  </view>
  <view wx:for="{{items}}" wx:key="id" class="card">
    <view class="row">
      <view>{{item.displayName}}</view>
      <text class="badge">{{item.statusLabel}}</text>
    </view>
    <view class="muted">{{item.username || '未填用户名'}} · {{item.maskedEmail || '无邮箱'}}</view>
    <button wx:if="{{item.status === 'ACTIVE' && item.mustChangePassword}}" class="secondary" data-id="{{item.id}}" bindtap="retry">重发邮件</button>
  </view>
</view>
