<view class="page">
  <view class="card">
    <view class="title">用户沟通</view>
    <view class="subtitle">{{forCs ? '本店待分配与已领取会话' : '店铺相关会话'}}</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
  <view wx:if="{{!loading && sessions.length === 0}}" class="card empty">暂无会话</view>
  <view wx:for="{{sessions}}" wx:key="sessionId" class="card">
    <view class="row" data-id="{{item.sessionId}}" bindtap="openThread">
      <view>{{item.subject || '客服咨询'}}</view>
      <text class="badge">{{item.statusLabel}}</text>
    </view>
    <view class="muted">{{item.lastMessage || '暂无消息'}}</view>
    <button wx:if="{{forCs && !item.csUserId}}" class="secondary" data-id="{{item.sessionId}}" bindtap="assign">领取会话</button>
  </view>
</view>
