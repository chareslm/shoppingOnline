<view class="page">
  <view class="card">
    <view class="title">经营统计</view>
    <view class="subtitle">{{shopName || '本店'}} · 最近 7 天精确查询</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
  <view wx:if="{{loading}}" class="card empty">正在读取经营统计…</view>
  <view wx:for="{{cards}}" wx:key="label" class="card">
    <view class="muted">{{item.label}}</view>
    <view class="title">{{item.value}}</view>
  </view>
</view>
