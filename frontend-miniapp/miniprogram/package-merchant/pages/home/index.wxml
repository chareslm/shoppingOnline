<view class="page">
  <view class="card">
    <view class="title">{{shopName || '商家工作台'}}</view>
    <view class="subtitle">管理本店商品、客服与经营数据</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
  <view class="card">
    <view wx:if="{{!csOnly}}" class="menu-item" bindtap="goAddProduct"><text>添加商品</text><text>›</text></view>
    <view wx:if="{{!csOnly}}" class="menu-item" bindtap="goProducts"><text>商品浏览</text><text>›</text></view>
    <view wx:if="{{isOwner}}" class="menu-item" bindtap="goStaff"><text>客服账号</text><text>›</text></view>
    <view wx:if="{{!csOnly}}" class="menu-item" bindtap="goStats"><text>经营统计</text><text>›</text></view>
    <view class="menu-item" bindtap="goInbox"><text>用户沟通</text><text>›</text></view>
    <view wx:if="{{canEnterUser}}" class="menu-item" bindtap="goUser"><text>切换到用户身份</text><text>›</text></view>
  </view>
  <button class="danger" loading="{{loading}}" disabled="{{loading}}" bindtap="logout">退出当前设备</button>
</view>
