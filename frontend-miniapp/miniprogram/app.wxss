page {
  box-sizing: border-box;
  min-height: 100%;
  background: #f5f7fa;
  color: #1f2937;
  font-size: 30rpx;
}

view,
input,
textarea,
button {
  box-sizing: border-box;
}

.page {
  padding: 32rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.06);
}

.title {
  margin-bottom: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.subtitle,
.muted {
  color: #64748b;
  line-height: 1.6;
}

.field {
  margin-top: 24rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #475569;
  font-size: 26rpx;
}

.input,
.textarea,
.picker {
  width: 100%;
  min-height: 84rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #dbe2ea;
  border-radius: 16rpx;
  background: #ffffff;
}

.textarea {
  min-height: 160rpx;
}

.primary,
.secondary,
.danger {
  margin-top: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.primary {
  background: #2563eb;
  color: #ffffff;
}

.secondary {
  border: 2rpx solid #cbd5e1;
  background: #ffffff;
  color: #334155;
}

.danger {
  background: #dc2626;
  color: #ffffff;
}

.link {
  color: #2563eb;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.error {
  margin-top: 20rpx;
  color: #dc2626;
  line-height: 1.5;
}

.empty {
  padding: 56rpx 20rpx;
  text-align: center;
  color: #94a3b8;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #eef2f7;
}

.menu-item:last-child {
  border-bottom: 0;
}

.tabs {
  display: flex;
  overflow: hidden;
  margin-top: 8rpx;
  border: 2rpx solid #dbe2ea;
  border-radius: 16rpx;
}

.tab {
  flex: 1;
  padding: 20rpx 12rpx;
  text-align: center;
  color: #475569;
}

.tab.active {
  background: #2563eb;
  color: #ffffff;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #2563eb;
  font-size: 24rpx;
}

.chip.active {
  background: #2563eb;
  color: #ffffff;
}

.price {
  color: #dc2626;
  font-weight: 600;
}

.thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #eef2f7;
  flex-shrink: 0;
}

.product-card {
  display: flex;
  gap: 20rpx;
}

.product-card .name {
  font-weight: 600;
  line-height: 1.5;
}

.badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #eef2f7;
  color: #475569;
  font-size: 22rpx;
}
