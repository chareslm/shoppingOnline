page {
  box-sizing: border-box;
  min-height: 100%;
  background: #f5f7fa;
  color: #1f2937;
  font-size: 30rpx;
}

view,
input,
textarea,
button {
  box-sizing: border-box;
}

.page {
  padding: 32rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.06);
}

.title {
  margin-bottom: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.subtitle,
.muted {
  color: #64748b;
  line-height: 1.6;
}

.field {
  margin-top: 24rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #475569;
  font-size: 26rpx;
}

.input,
.textarea,
.picker {
  width: 100%;
  min-height: 84rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #dbe2ea;
  border-radius: 16rpx;
  background: #ffffff;
}

.textarea {
  min-height: 160rpx;
}

.primary,
.secondary,
.danger {
  margin-top: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.primary {
  background: #2563eb;
  color: #ffffff;
}

.secondary {
  border: 2rpx solid #cbd5e1;
  background: #ffffff;
  color: #334155;
}

.danger {
  background: #dc2626;
  color: #ffffff;
}

.link {
  color: #2563eb;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.error {
  margin-top: 20rpx;
  color: #dc2626;
  line-height: 1.5;
}

.empty {
  padding: 56rpx 20rpx;
  text-align: center;
  color: #94a3b8;
}
