.pay-card {
  margin-top: 60rpx;
  padding: 64rpx 32rpx;
  text-align: center;
}

.amount {
  margin: 24rpx 0;
  font-size: 72rpx;
  font-weight: 700;
}

.status-row {
  margin-bottom: 24rpx;
}

.status-tag {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #fef3c7;
  color: #b45309;
  font-size: 24rpx;
}

.status-tag.success {
  background: #dcfce7;
  color: #15803d;
}

.meta {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #475569;
  word-break: break-all;
}

.wide-btn {
  margin-top: 48rpx;
}

.paid-tip {
  margin-top: 48rpx;
  color: #15803d;
  font-weight: 600;
}
