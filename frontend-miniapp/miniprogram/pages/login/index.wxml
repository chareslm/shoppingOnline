<view class="page">
  <view class="card">
    <view class="title">欢迎回来</view>
    <view class="subtitle">{{portalMode === 'merchant' ? '商家主账号管理店铺。客服请选择商家身份，登录后进入用户沟通。' : '使用平台账号登录微信小程序。商家与客服请切换到商家身份。'}}</view>

    <view class="tabs">
      <view class="tab {{portalMode === 'user' ? 'active' : ''}}" bindtap="selectUser">用户身份</view>
      <view class="tab {{portalMode === 'merchant' ? 'active' : ''}}" bindtap="selectMerchant">商家身份</view>
    </view>

    <view class="field">
      <text class="label">用户名、邮箱或手机号</text>
      <input class="input" value="{{identifier}}" bindinput="onIdentifierInput" placeholder="请输入登录标识" />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <input class="input" value="{{password}}" bindinput="onPasswordInput" password placeholder="请输入密码" />
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="submit">登录</button>
    <button class="secondary" disabled="{{loading}}" bindtap="goRegister">{{portalMode === 'merchant' ? '申请商家入驻' : '注册新账号'}}</button>
  </view>
</view>
