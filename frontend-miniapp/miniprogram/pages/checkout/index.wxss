.checkout-page {
  padding-bottom: 180rpx;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.empty-inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.address-option {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #eef2f7;
}

.address-option:last-child {
  border-bottom: none;
}

.address-info {
  flex: 1;
  min-width: 0;
}

.default-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 22rpx;
}

.address-text {
  margin-top: 10rpx;
}

.order-line {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
}

.line-name {
  flex: 1;
  min-width: 0;
}

.line-subtotal {
  font-weight: 600;
}

.remark {
  margin-top: 0;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 28rpx rgba(15, 23, 42, 0.08);
}

.summary {
  color: #475569;
}

.total {
  color: #dc2626;
  font-size: 34rpx;
  font-weight: 700;
}

.submit-btn {
  margin-top: 0;
  width: 240rpx;
}
