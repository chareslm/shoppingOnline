<view class="page">
  <view class="card heading">
    <view class="title">登录设备</view>
    <view class="subtitle">查看使用过本账号的设备，并撤销不再使用的登录会话。</view>
    <button class="secondary compact" loading="{{actingId === 'others'}}" disabled="{{!!actingId}}" bindtap="revokeOthers">退出其他设备</button>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>

  <view wx:if="{{loading}}" class="card empty">正在加载登录设备…</view>
  <view wx:elif="{{!devices.length}}" class="card empty">暂无设备记录</view>
  <view wx:else>
    <view wx:for="{{devices}}" wx:key="id" class="card device-card {{item.current ? 'current' : ''}}">
      <view class="row device-head">
        <view>
          <view class="device-title">{{item.title}}</view>
          <view class="muted">{{item.typeLabel}}{{item.appVersion ? ' · ' + item.appVersion : ''}}</view>
        </view>
        <view wx:if="{{item.current}}" class="badge">当前设备</view>
      </view>
      <view class="meta">最近活跃：{{item.lastActiveLabel}}</view>
      <view class="meta">IP：{{item.maskedIp || '未知'}}</view>
      <view class="meta">会话有效期：{{item.expiresLabel}}</view>
      <button class="danger compact" data-id="{{item.id}}" loading="{{actingId === item.id}}" disabled="{{!!actingId}}" bindtap="revokeDevice">{{item.current ? '退出当前设备' : '退出设备'}}</button>
    </view>
  </view>

  <view class="notice">退出后 Refresh Token 会立即失效；已签发的 Access Token 最长仍可能使用 30 分钟。</view>
</view>
