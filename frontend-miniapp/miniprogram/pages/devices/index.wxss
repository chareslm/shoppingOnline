.heading .compact {
  margin-top: 24rpx;
}

.device-card.current {
  border: 2rpx solid #2563eb;
}

.device-head {
  align-items: flex-start;
}

.device-title {
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.badge {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 22rpx;
}

.meta {
  margin-top: 14rpx;
  color: #64748b;
  font-size: 25rpx;
}

.compact {
  min-height: 72rpx;
  line-height: 72rpx;
  font-size: 27rpx;
}

.notice {
  padding: 12rpx 8rpx 32rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}
