<view class="page">
  <view class="card">
    <view class="field">
      <text class="label">收货人</text>
      <input class="input" value="{{recipientName}}" bindinput="onNameInput" maxlength="50" />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" value="{{recipientPhone}}" bindinput="onPhoneInput" type="number" maxlength="20" />
    </view>
    <view class="field">
      <text class="label">省市区</text>
      <picker class="picker" mode="region" value="{{region}}" bindchange="onRegionChange">
        <view>{{regionText || '请选择省市区'}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">详细地址</text>
      <textarea class="textarea" value="{{detailAddress}}" bindinput="onDetailInput" maxlength="255" />
    </view>
    <view class="field">
      <text class="label">邮政编码</text>
      <input class="input" value="{{postalCode}}" bindinput="onPostalInput" maxlength="20" placeholder="可选" />
    </view>
    <view class="row field">
      <text>设为默认地址</text>
      <switch checked="{{isDefault}}" bindchange="onDefaultChange" />
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="save">保存地址</button>
  </view>
</view>
