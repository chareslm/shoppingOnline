.tabs {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.tab {
  display: inline-block;
  padding: 14rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #475569;
  font-size: 26rpx;
}

.tab.active {
  background: #2563eb;
  color: #ffffff;
}

.order-no {
  font-size: 24rpx;
}

.status-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status-tag.warning {
  background: #fef3c7;
  color: #b45309;
}

.status-tag.info {
  background: #dbeafe;
  color: #1d4ed8;
}

.status-tag.success {
  background: #dcfce7;
  color: #15803d;
}

.status-tag.refund {
  background: #fae8ff;
  color: #a21caf;
}

.status-tag.closed {
  background: #e2e8f0;
  color: #64748b;
}

.order-summary {
  margin-top: 18rpx;
  font-weight: 500;
}

.order-bottom {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #eef2f7;
}

.amount {
  font-weight: 600;
}

.count {
  font-weight: 400;
  font-size: 24rpx;
}

.pay-mini {
  margin-top: 0;
}
