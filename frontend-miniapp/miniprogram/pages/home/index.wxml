<view class="page">
  <view class="card">
    <view class="title">你好，{{username || '用户'}}</view>
    <view class="subtitle">浏览商品、联系客服并管理个人资料与订单</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>

  <view class="card menu">
    <view class="menu-item" wx:if="{{canEnterMerchant}}" bindtap="goMerchant"><text>进入商家工作台</text><text>›</text></view>
    <view class="menu-item" bindtap="goProducts"><text>商品</text><text>›</text></view>
    <view class="menu-item" bindtap="goChat"><text>客服沟通</text><text>›</text></view>
    <view class="menu-item" bindtap="goNotifications"><text>消息通知</text><text>›</text></view>
    <view class="menu-item" bindtap="goCart"><text>购物车</text><text>›</text></view>
    <view class="menu-item" bindtap="goOrders"><text>我的订单</text><text>›</text></view>
    <view class="menu-item" bindtap="goProfile"><text>个人资料</text><text>›</text></view>
    <view class="menu-item" bindtap="goAddresses"><text>收货地址</text><text>›</text></view>
    <view class="menu-item" bindtap="goPreferences"><text>偏好设置</text><text>›</text></view>
    <view class="menu-item" bindtap="goPassword"><text>修改密码</text><text>›</text></view>
    <view class="menu-item" bindtap="goDevices"><text>登录设备</text><text>›</text></view>
    <view class="menu-item" bindtap="goStatistics"><text>消费统计</text><text>›</text></view>
  </view>

  <button class="danger" loading="{{loading}}" disabled="{{loading}}" bindtap="logout">退出当前设备</button>
</view>
