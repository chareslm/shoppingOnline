<view class="page">
  <view class="card">
    <view class="title">你好，{{username || '用户'}}</view>
    <view class="subtitle">当前账号已通过 USER 角色校验</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>

  <view class="card menu">
    <view class="menu-item" bindtap="goProfile"><text>个人资料</text><text>›</text></view>
    <view class="menu-item" bindtap="goAddresses"><text>收货地址</text><text>›</text></view>
    <view class="menu-item" bindtap="goPreferences"><text>偏好设置</text><text>›</text></view>
    <view class="menu-item" bindtap="goPassword"><text>修改密码</text><text>›</text></view>
    <view class="menu-item" bindtap="goDevices"><text>登录设备</text><text>›</text></view>
  </view>

  <button class="danger" loading="{{loading}}" disabled="{{loading}}" bindtap="logout">退出当前设备</button>
</view>
