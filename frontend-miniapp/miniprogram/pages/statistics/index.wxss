.range-row {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
}

.range-row .picker {
  min-height: auto;
  padding: 18rpx;
  text-align: center;
}

.metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.metric-card {
  min-height: 220rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.06);
}

.metric-label,
.metric-description,
.note {
  color: #64748b;
}

.metric-value {
  margin: 24rpx 0 12rpx;
  color: #1d4ed8;
  font-size: 38rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.metric-description,
.note {
  font-size: 24rpx;
  line-height: 1.7;
}

.note view + view {
  margin-top: 16rpx;
}
