<view class="page">
  <view class="card">
    <view class="title">客服沟通</view>
    <view class="field">
      <text class="label">首条消息</text>
      <textarea class="textarea" value="{{firstMessage}}" bindinput="onFirstMessageInput" placeholder="请描述你的问题" />
    </view>
    <view class="field">
      <text class="label">店铺 ID（选填）</text>
      <input class="input" value="{{shopId}}" bindinput="onShopIdInput" placeholder="咨询指定店铺时填写" />
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="primary" loading="{{creating}}" bindtap="createSession">发起咨询</button>
  </view>
  <view wx:if="{{!loading && sessions.length === 0}}" class="card empty">暂无会话</view>
  <view wx:for="{{sessions}}" wx:key="sessionId" class="card menu-item" data-id="{{item.sessionId}}" bindtap="openThread">
    <view>
      <view>{{item.subject || '客服咨询'}}</view>
      <view class="muted">{{item.lastMessage || '暂无消息'}}</view>
    </view>
    <text class="badge">{{item.statusLabel}}</text>
  </view>
</view>
