<view class="page">
  <view class="card">
    <view class="title">消息通知</view>
    <button class="secondary" bindtap="markAll">全部已读</button>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
  <view wx:if="{{!loading && items.length === 0}}" class="card empty">暂无通知</view>
  <view wx:for="{{items}}" wx:key="id" class="card">
    <view class="row">
      <view>{{item.title}}</view>
      <text class="badge">{{item.isRead === 1 ? '已读' : '未读'}}</text>
    </view>
    <view class="muted">{{item.categoryDesc || ''}}</view>
    <view>{{item.content}}</view>
    <button wx:if="{{item.isRead === 0}}" class="secondary" data-id="{{item.id}}" bindtap="markRead">标记已读</button>
  </view>
</view>
