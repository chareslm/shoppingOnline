<view class="page">
  <view wx:if="{{error}}" class="error card">{{error}}</view>
  <view wx:if="{{loading}}" class="card empty">正在加载商品…</view>

  <block wx:if="{{detail}}">
    <view class="card">
      <swiper wx:if="{{images.length}}" class="gallery" indicator-dots>
        <swiper-item wx:for="{{images}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" class="gallery-image" />
        </swiper-item>
      </swiper>
      <view class="badge">{{statusLabel}}</view>
      <view class="title">{{detail.name}}</view>
      <view class="muted">{{detail.subtitle || detail.brand || '暂无副标题'}}</view>
      <view class="price">¥{{selectedSku.price || detail.priceMin}}</view>
      <view class="muted">已售 {{detail.sales}} · 评分 {{detail.rating}}</view>
    </view>

    <view class="card">
      <view class="subtitle">选择规格</view>
      <block wx:if="{{specAxes.length}}">
        <view wx:for="{{specAxes}}" wx:key="name" class="field">
          <text class="label">{{item.name}}</text>
          <view class="chip-row">
            <view
              wx:for="{{item.values}}"
              wx:for-item="option"
              wx:key="value"
              class="chip {{option.selected ? 'active' : ''}}"
              data-name="{{item.name}}"
              data-value="{{option.value}}"
              bindtap="selectSpec"
            >{{option.value}}</view>
          </view>
        </view>
      </block>
      <block wx:else>
        <view wx:for="{{skus}}" wx:key="id" class="menu-item" data-index="{{index}}" bindtap="selectSkuByIndex">
          <view>
            <view>默认规格</view>
            <view class="muted">库存 {{item.availableStock}}</view>
          </view>
          <view class="{{selectedSku.id === item.id ? 'price' : 'muted'}}">¥{{item.price}}</view>
        </view>
      </block>
      <view wx:if="{{selectedSku}}" class="muted" style="margin-top: 16rpx;">已选 {{selectedSku.attrText}} · 库存 {{selectedSku.availableStock}}</view>
      <view class="row" style="margin-top: 24rpx;">
        <text>数量</text>
        <view class="row">
          <button size="mini" data-delta="-1" bindtap="changeQuantity">−</button>
          <text>{{quantity}}</text>
          <button size="mini" data-delta="1" bindtap="changeQuantity">+</button>
        </view>
      </view>
      <button class="primary" loading="{{submitting}}" disabled="{{submitting || !selectedSku}}" bindtap="addToCart">加入购物车</button>
    </view>

    <view class="card" wx:if="{{stats}}">
      <view class="subtitle">评价 {{stats.averageRating}} 分 · {{stats.totalCount}} 条 · 好评率 {{stats.positiveRate}}%</view>
      <view wx:if="{{reviews.length === 0}}" class="empty">还没有评价</view>
      <view wx:for="{{reviews}}" wx:key="id" class="review">
        <view class="row">
          <text>{{item.anonymous ? '匿名用户' : '用户'}} · {{item.rating}} 星</text>
          <text class="muted">{{item.createdAt}}</text>
        </view>
        <view>{{item.content || '此用户没有填写评价内容'}}</view>
        <view wx:if="{{item.reply}}" class="muted">商家回复：{{item.reply}}</view>
      </view>
    </view>
  </block>
</view>
