# Copy to deploy/.env (gitignored). deploy-local.ps1 fills empty/placeholder values
# so a first run can start without editing this file.
#
# Tags:
#   [REQUIRED]  Must be a real secret. The deploy script generates one when the
#               value is empty or still starts with replace-.
#   [OPTIONAL]  Safe to leave empty or at the documented default.
#   [NATIVE]    Used only when running Spring Boot on the host, not in Compose.

# -----------------------------------------------------------------------------
# [OPTIONAL] Persistent data root on the host.
# Leave empty: deploy-local.ps1 writes %USERPROFILE%/shopping-data
# Actual bind mounts are ${DATA_DIR}/shopping/{mysql,redis,elasticsearch,uploads}
# Change only when you want data on another disk.
# -----------------------------------------------------------------------------
DATA_DIR=

# -----------------------------------------------------------------------------
# [OPTIONAL] Host ports and database name. Change only on port conflicts.
# -----------------------------------------------------------------------------
MYSQL_PORT=3306
MYSQL_DATABASE=shopping
MYSQL_USER=shopping_app
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200
BACKEND_PORT=8080

# -----------------------------------------------------------------------------
# [REQUIRED] Secrets. Do not reuse values. Never commit deploy/.env.
# Leave as replace-* and let deploy-local.ps1 generate them, or paste your own.
# -----------------------------------------------------------------------------
MYSQL_APP_PASSWORD=replace-with-a-long-random-application-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-root-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# -----------------------------------------------------------------------------
# [OPTIONAL] Maven cache on the host, mounted to /root/.m2 in the backend
# container. Leave empty: deploy-local.ps1 writes %USERPROFILE%/.m2
# -----------------------------------------------------------------------------
MAVEN_REPO_DIR=

# -----------------------------------------------------------------------------
# [NATIVE][OPTIONAL] Upload directory for a host-run backend.
# Compose always uses the container path /data/uploads (mapped from
# ${DATA_DIR}/shopping/uploads) and ignores this value.
# Leave empty: deploy-local.ps1 writes ${DATA_DIR}/shopping/uploads
# -----------------------------------------------------------------------------
MERCHANT_UPLOAD_DIR=

# -----------------------------------------------------------------------------
# [OPTIONAL] First-run SUPER_ADMIN. Compose passes these into the backend.
# Leave enabled=false and password empty to skip. deploy-local.ps1 on a fresh
# .env enables it once and prints the password. Disable after first login.
# See docs/auth-bootstrap.md
# -----------------------------------------------------------------------------
BOOTSTRAP_SUPER_ADMIN_ENABLED=false
BOOTSTRAP_SUPER_ADMIN_USERNAME=admin_local
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# [OPTIONAL] SMTP used until an admin saves runtime settings.
# Leave MAIL_HOST empty to skip sending mail (approvals still succeed;
# delivery is SKIPPED or MAIL_FAILED and can be retried).
# Do not keep smtp.example.com: Compose would attempt a fake host.
# Runtime toggle also exists on the system-admin SMTP page (enabled switch).
# -----------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLED=true
