# Copy this file to deploy/.env and replace every password before starting MySQL.
MYSQL_PORT=3306
MYSQL_DATABASE=shopping
MYSQL_USER=shopping_app
MYSQL_APP_PASSWORD=replace-with-a-long-random-application-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-root-password

# Redis is bound to 127.0.0.1 only. The backend defaults to this port.
REDIS_PORT=6379

# Elasticsearch is bound to 127.0.0.1 only. The backend defaults to this port.
ELASTICSEARCH_PORT=9200
