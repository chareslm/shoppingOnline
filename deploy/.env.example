# Local deployment template.
# Copy to deploy/.env before deployment. deploy/.env is ignored by Git.
# [OPTIONAL] Persistent-data root. The project uses the shopping/ subdirectory.
DATA_DIR=folder

# [OPTIONAL] Host ports and database name/user; modify only when local ports conflict.
MYSQL_PORT=3306
MYSQL_DATABASE=shopping
MYSQL_USER=shopping_app

# [REQUIRED] Replace all three values. Do not reuse passwords or commit deploy/.env.
MYSQL_APP_PASSWORD=replace-with-a-long-random-application-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-root-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# [OPTIONAL] Backend port and host Maven cache path.
BACKEND_PORT=8080
MAVEN_REPO_DIR=folder

# [OPTIONAL] Redis and Elasticsearch are bound to localhost only.
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200

# [OPTIONAL/NATIVE] Used when running the backend directly on Windows.
# Compose always maps ${DATA_DIR}/shopping/uploads to /data/uploads in the backend container.
MERCHANT_UPLOAD_DIR=folder

# [OPTIONAL] Generic SMTP. Leave MAIL_HOST/USERNAME/PASSWORD/FROM empty to disable
# real delivery; approved applications then become MAIL_FAILED and can be retried.
# For production-like testing, replace all four values with provider settings.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-account
MAIL_PASSWORD=replace-with-smtp-authorization-code
MAIL_FROM=no-reply@example.com

# [OPTIONAL] Most port-587 providers use both values below. SSL-on-connect
# providers commonly use port 465 and may require additional provider settings.
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLED=true
